# Daily Resales dump. The server clock for this line is Europe/Madrid.
# The API key is NOT here. It is exported from /root/.config/amaranthus/resales.env
# Install as /etc/cron.d/amaranthus-resales (the filename must not contain a dot).
CRON_TZ=Europe/Madrid
0 7 * * * root . /root/.config/amaranthus/resales.env && /usr/bin/python3 /root/Archon/amaranthus-crm/sync/resales_dump.py >> /var/log/amaranthus-resales.log 2>&1
